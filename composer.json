{
    "name": "spryker-community/search-feedback",
    "type": "library",
    "description": "SRP feedback ticketing: lets an authorized storefront admin file a free-text ticket about a set of search results (query, filters, page, SKUs shown), and lets Zed admins hold a conversation about it back-office. A voice-of-customer capture tool, not a ranking-signal one.",
    "license": "MIT",
    "keywords": [
        "spryker",
        "search",
        "feedback",
        "support",
        "ticketing"
    ],
    "require": {
        "php": ">=8.3",
        "spryker/acl": "^3.27.0",
        "spryker/customer": "^7.0.0 || ^8.0.0",
        "spryker/company-user": "^2.0.0",
        "spryker/gui": "^3.30.0 || ^5.0.0",
        "spryker/kernel": "^3.30.0",
        "spryker/permission-extension": "^1.2.0",
        "spryker/propel-orm": "^1.24.0",
        "spryker/store": "^1.0.0",
        "spryker/transfer": "^3.25.0",
        "spryker/user": "^3.30.0",
        "spryker/zed-request": "^3.10.0",
        "symfony/console": "^6.0.0 || ^7.0.0",
        "symfony/form": "^6.0.0 || ^7.0.0",
        "symfony/http-foundation": "^6.0.0 || ^7.0.0",
        "symfony/security-csrf": "^6.0.0 || ^7.0.0"
    },
    "require-dev": {
        "codeception/codeception": "^5.0.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
        "phpmd/phpmd": "^2.15.0",
        "phpstan/phpstan": "^2.0.0",
        "phpunit/phpunit": "^10.0.0 || ^11.0.0",
        "rector/rector": "^2.0",
        "spryker/code-sniffer": "^0.17.30"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/andrebarthelmeshellmuth/spryker-search-feedback"
        }
    ],
    "scripts": {
        "rector": "rector process",
        "rector-dry-run": "rector process --dry-run",
        "phpstan": "phpstan analyse -c phpstan.neon src/"
    },
    "scripts-descriptions": {
        "rector": "Applies Rector's configured rule sets (PHP floor upgrades + level-0 dead-code/code-quality) to src/ and tests/.",
        "rector-dry-run": "Shows what Rector would change without writing anything.",
        "phpstan": "Static analysis at level 8. Must be run from a host shop — needs the shop's generated Generated\\Shared\\Transfer\\* classes and a freshly regenerated Ide/AutoCompletion stub."
    },
    "autoload": {
        "psr-4": {
            "SprykerCommunity\\": "src/SprykerCommunity/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SprykerCommunityTest\\": "tests/SprykerCommunityTest/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "homepage": "https://github.com/andrebarthelmeshellmuth/spryker-search-feedback",
    "authors": [
        {
            "name": "Andre Barthelmes",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/andrebarthelmeshellmuth/spryker-search-feedback/issues",
        "source": "https://github.com/andrebarthelmeshellmuth/spryker-search-feedback"
    }
}
