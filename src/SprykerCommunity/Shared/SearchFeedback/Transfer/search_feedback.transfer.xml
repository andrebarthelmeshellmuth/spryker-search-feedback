<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <!-- Yves -> Zed gateway request: submits one new ticket about the SRP the customer is currently
         looking at. filters is the raw active-facet query state (e.g. {"category": ["123"], "brand":
         ["456"]}), skuList is every product SKU rendered on that page — both reconstructed from hidden
         form fields the ticket-form template fills in server-side at RENDER time, but read back from the
         plain POST body at SUBMIT time (SubmitTicketController::submitAction()), same as searchTerm and
         pageNumber. None of the four is independently re-verified against a live search — a submitter
         could edit these fields before posting. That is an accepted trade-off for this package (the data
         is qualitative "what was this ticket about" context for a human Zed admin to read, always
         HTML-escaped on display, never fed into an automated system), not a bug — but do not treat these
         four as attacker-proof. customerReference is the one field that IS trustworthy: set server-side
         by the Yves controller from the authenticated session, never read from request input. -->
    <transfer name="SearchFeedbackTicketRequest" strict="true">
        <property name="topic" type="string"/>
        <property name="searchTerm" type="string"/>
        <property name="filters" type="array"/>
        <property name="pageNumber" type="int"/>
        <property name="skuList" type="string[]" singular="sku"/>
        <property name="body" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
    </transfer>

    <!-- Zed -> Yves gateway response. isSuccess=false covers both an unauthorized caller (re-checked
         server-side, never trusted from the Yves-side permission check alone) and a validation failure
         (e.g. empty body). -->
    <transfer name="SearchFeedbackTicketResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="errorMessage" type="string"/>
        <property name="ticket" type="SearchFeedbackTicket"/>
    </transfer>

    <!-- One ticket: the structured SRP context it was filed against, plus the full message thread
         (messages[0] is always the customer's original submitted body). status is one of
         SearchFeedbackConfig::STATUS_*. -->
    <transfer name="SearchFeedbackTicket" strict="true">
        <property name="idSearchFeedbackTicket" type="int"/>
        <property name="topic" type="string"/>
        <property name="searchTerm" type="string"/>
        <property name="filters" type="array"/>
        <property name="pageNumber" type="int"/>
        <property name="skuList" type="string[]" singular="sku"/>
        <property name="status" type="string"/>
        <property name="storeName" type="string"/>
        <property name="localeName" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="createdAt" type="string"/>
        <property name="updatedAt" type="string"/>
        <property name="messages" type="SearchFeedbackTicketMessage[]" singular="message"/>
    </transfer>

    <!-- One message in a ticket's thread. authorType is one of SearchFeedbackConfig::AUTHOR_TYPE_* —
         exactly one of the two identity fields is set to match it: customerReference for
         AUTHOR_TYPE_CUSTOMER, idUser/authorLabel (the Zed user's username) for AUTHOR_TYPE_ZED_USER. -->
    <transfer name="SearchFeedbackTicketMessage" strict="true">
        <property name="idSearchFeedbackTicketMessage" type="int"/>
        <property name="fkSearchFeedbackTicket" type="int"/>
        <property name="body" type="string"/>
        <property name="authorType" type="string"/>
        <property name="authorLabel" type="string"/>
        <property name="createdAt" type="string"/>
    </transfer>

    <!-- Zed-internal request to append a reply to an existing ticket's thread, or to change its status —
         posted from the Zed Detail controller's Symfony Form, never crosses the Yves/Zed boundary. -->
    <transfer name="SearchFeedbackTicketMessageRequest" strict="true">
        <property name="idSearchFeedbackTicket" type="int"/>
        <property name="body" type="string"/>
        <property name="idUser" type="int"/>
    </transfer>

    <transfer name="SearchFeedbackTicketCollection" strict="true">
        <property name="tickets" type="SearchFeedbackTicket[]" singular="ticket"/>
    </transfer>

    <!-- How much of the back office can actually reach this package's Zed pages, for
         `search-feedback:check-installation` to report on. Zed access is deny-by-default outside a matching
         ACL rule, and a nav entry the current user has no rule for is filtered out of the sidebar entirely
         (see Spryker's own AclNavigationItemFilterPlugin) rather than 403ing — so "the adopter never
         adjusted ACL" looks exactly like "the package was never installed".

         The split that matters is unrestrictedRoleCount vs restrictedRoleCount. A default Spryker install
         gives root_role a total wildcard and puts every installer user in root_group, so these pages are
         reachable out of the box and nothing needs doing — that is the unrestricted count. Roles carrying
         explicit per-module rules instead are the restricted count, and they reach nothing here until
         somebody adds a rule. restrictedRoleWithAccessCount separates "the adopter pointed a restricted
         role at this feature" from "no restricted role can see it", which is the only state worth
         mentioning — and even then only as something to confirm, never as a failure: restricting these
         pages to root-style admins is a perfectly ordinary choice.

         Counts rather than names deliberately: this is a yes/no/how-many signal about the shape of an
         installation, and printing an adopter's internal role names into console output buys nothing. -->
    <transfer name="SearchFeedbackBackOfficeAccessDiagnosis" strict="true">
        <property name="moduleNames" type="string[]" singular="moduleName"/>
        <property name="unrestrictedRoleCount" type="int"/>
        <property name="restrictedRoleCount" type="int"/>
        <property name="restrictedRoleWithAccessCount" type="int"/>
    </transfer>

</transfers>
